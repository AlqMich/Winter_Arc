{
  "name": "winter-arc",
  "version": "1.0.0",
  "private": true,
  "description": "Winter Arc — app personal (PWA) para seguimiento de un reto de 90 días.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "test": "npx tsx tests/logic.test.ts && node tests/push.test.mjs",
