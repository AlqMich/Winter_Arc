    "preview": "cd dist && python3 -m http.server 4173"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@netlify/blobs": ">=8.1.0 <11"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}